# Variables de entorno (sin valores reales). Copiar a .env para local.
# API
DATABASE_URL=postgresql://inscripciones:inscripciones@localhost:5434/inscripciones
DIRECT_URL=postgresql://inscripciones:inscripciones@localhost:5434/inscripciones
JWT_SECRET=cambiar-en-local-minimo-16-caracteres
JWT_EXPIRES_IN=24h
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
PORT=3001
NODE_ENV=development
# Storage local (disco) o Supabase. En producción NUNCA disk.
STORAGE_DRIVER=disk
UPLOADS_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=public-assets
SUPABASE_PRIVATE_BUCKET=certificate-templates
# Correo SMTP/Brevo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
MAIL_DAILY_LIMIT=300
# Solo para seed inicial (nunca con valores por defecto en el repo)
ADMIN_EMAIL=
ADMIN_PASSWORD=
