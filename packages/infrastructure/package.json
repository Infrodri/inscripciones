{
  "dependencies": {
    "@supabase/supabase-js": "2.47.0",
    "nodemailer": "6.9.15",
    "pdfkit": "0.17.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "20.16.0",
    "@types/nodemailer": "6.4.16",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "1.5.5",
    "typescript": "5.5.4",
    "vitest": "2.1.8"
  },
  "name": "@inscripciones/infrastructure",
  "private": true,
  "exports": {
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/assets', {recursive:true}); if (fs.existsSync('assets/facultad-derecho-usfx.jpg')) fs.copyFileSync('assets/facultad-derecho-usfx.jpg', 'dist/assets/facultad-derecho-usfx.jpg');\"",
    "test": "vitest run --passWithNoTests"
  },
  "version": "0.1.0"
}
